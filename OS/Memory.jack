/**
 * This library provides two services: direct access to the computer's main
 * memory (RAM), and allocation and recycling of memory blocks. The Hack RAM
 * consists of 32,768 words, each holding a 16-bit binary number.
 */ 
class Memory {
    
    static Array memory, freeList;
    static int heapBase;

    /** Initializes the class. */
    function void init() {
        let memory = 0;
        let heapBase = 2048;
        let freeList = heapBase;
        let freeList[0] = 14336; // block size
        let freeList[1] = 0; // next block pointer (initially null)
        return;
    }

    /** Returns the RAM value at the given address. */
    function int peek(int address) {
        var int val;
        let val = memory[address];
        return val;
    }

    /** Sets the RAM value at the given address to the given value. */
    function void poke(int address, int value) {
        let memory[address] = value;
        return;
    }

    /** Finds an available RAM block of the given size and returns
     *  a reference to its base address. */
    function int alloc(int size) {
        // first-fit
        var Array curr, block;
        var boolean found;

        let found = false;
        let curr = freeList; // 2048
        
        while(~(curr = 0) & ~found){ // the block is too small
            if (~(curr[0] < (size + 3))){
                let found = true;
            } else {
                let curr = curr[1]; // next free block
            }
            
        }

        if (curr = 0){
            return 0;
        }

        let curr[0] = curr[0] - (size + 1); // new size after allocation
        // size ... ... ... next
        let block = curr + curr[0]; // base adress + size (end of block)
        let block[0] = size + 1; // size of allocated block
        return block + 1; // first free space of allocated block (after its size)
    }

    /** De-allocates the given object (cast as an array) by making
     *  it available for future allocations. */
    function void deAlloc(Array o) {
        var Array segment;

        let segment = o - 1; 
        let segment[1] = freeList; // sed this segment's next to be the current freeList's next
        let freeList = segment; // add the current segment to the head of the current freeList and keep its size
        // freeList -> segment -> next
        return;
    }    
}
